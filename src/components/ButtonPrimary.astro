---
import Icon from "./Icon.astro";

interface Props {
  href: string;
  class?: string;
  target?: string;
  rel?: string;
}

const { href, class: className = "", target, rel } = Astro.props;
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={[
    "btn-glow group inline-flex items-center gap-2.5 rounded-[10px] border border-gold px-7 py-4",
    "font-medium text-[16px] text-navy-950 bg-linear-to-b from-gold-hi to-gold",
    "shadow-[0_10px_38px_rgba(217,189,133,0.32),0_0_60px_rgba(217,189,133,0.16)]",
    "transition-[transform,box-shadow,filter] duration-250 ease-out",
    "hover:-translate-y-0.5 hover:shadow-[0_18px_54px_rgba(217,189,133,0.48),0_0_90px_rgba(217,189,133,0.26)] hover:brightness-110",
    "focus-visible:outline-2 focus-visible:outline-gold focus-visible:outline-offset-3",
    className,
  ]}
>
  <span class="btn-glow-light" aria-hidden="true"></span>
  <slot />
  <Icon
    name="arrow-right"
    class="size-[18px] transition-transform duration-250 ease-out group-hover:translate-x-0.5"
  />
</a>
