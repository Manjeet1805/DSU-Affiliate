---
interface Props {
  name:
    | "arrow-right"
    | "shield-check"
    | "euro"
    | "wallet"
    | "video"
    | "play"
    | "mouse"
    | "chevron-down"
    | "lock"
    | "user"
    | "star"
    | "camera"
    | "film"
    | "chart"
    | "lock-open";
  class?: string;
}

const { name, class: className = "" } = Astro.props;
---

{
  name === "arrow-right" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "shield-check" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M9 12l2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "euro" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M17 6.5a6.5 6.5 0 100 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <path d="M6 10h9M6 14h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "wallet" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M3 7.5A2.5 2.5 0 015.5 5H18a2 2 0 012 2v1H5.5A2.5 2.5 0 013 5.5v2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M3 7.5V17a2 2 0 002 2h14a1 1 0 001-1v-9a1 1 0 00-1-1H5.5A2.5 2.5 0 013 7.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M16.5 14a1 1 0 100-2 1 1 0 000 2z" fill="currentColor" />
    </svg>
  )
}
{
  name === "video" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <rect x="3" y="6" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.6" />
      <path d="M16 10.5l5-2.7v8.4l-5-2.7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "play" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M8 5.5v13l11-6.5-11-6.5z" fill="currentColor" />
    </svg>
  )
}
{
  name === "mouse" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <rect x="7" y="3" width="10" height="17" rx="5" stroke="currentColor" stroke-width="1.6" />
      <path d="M12 7v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "chevron-down" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "lock" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <rect x="5" y="10.5" width="14" height="9.5" rx="2" stroke="currentColor" stroke-width="1.6" />
      <path d="M8 10.5V8a4 4 0 118 0v2.5" stroke="currentColor" stroke-width="1.6" />
    </svg>
  )
}
{
  name === "user" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <circle cx="12" cy="8.5" r="3.5" stroke="currentColor" stroke-width="1.6" />
      <path d="M4.5 19.5c1.4-3.6 4.3-5.5 7.5-5.5s6.1 1.9 7.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "star" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M12 3.5l2.35 5.2 5.65.55-4.25 3.8 1.25 5.55L12 15.75l-5 2.85 1.25-5.55-4.25-3.8 5.65-.55L12 3.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "camera" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M4 8.5A2 2 0 016 6.5h2.2l1-1.5h5.6l1 1.5H18a2 2 0 012 2v9a2 2 0 01-2 2H6a2 2 0 01-2-2v-9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <circle cx="12" cy="13" r="3.2" stroke="currentColor" stroke-width="1.6" />
    </svg>
  )
}
{
  name === "film" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M4 10.5l1.3-4.3a1.5 1.5 0 011.9-1l11.6 3a1.5 1.5 0 011.1 1.8l-.4 1.5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <rect x="4" y="10.5" width="16" height="8.5" rx="1.5" stroke="currentColor" stroke-width="1.6" />
      <path d="M7.5 6l2 4.5M12.5 5l2 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "chart" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M5 19V11M12 19V5M19 19v-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "lock-open" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <rect x="5" y="10.5" width="14" height="9.5" rx="2" stroke="currentColor" stroke-width="1.6" />
      <path d="M8 10.5V8a4 4 0 017.6-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )
}
