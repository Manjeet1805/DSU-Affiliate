---
import DashboardPreview from "./steps/DashboardPreview.astro";

const steps = [
  {
    n: 1,
    title: "Register",
    text: 'Register at copecart.com, choose region "Europe" or "United States", and select the role "Affiliate/Partner Program" (not "Seller").',
    delay: 60,
    final: false,
  },
  {
    n: 2,
    title: "Fill in Account Details",
    text: "Enter your email, username, phone number, company name, address, and tax number, set a password, and create your account.",
    delay: 140,
    final: false,
  },
  {
    n: 3,
    title: "Verify Your Identity (KYC)",
    text: "Complete verification by uploading your ID — required so commissions can be paid out later.",
    delay: 220,
    final: false,
  },
  {
    n: 4,
    title: "Apply for DSU Platinum and Get Your Link",
    text: 'In the dashboard, go to "Marketplace", search for "DSU", and click "Apply". Once approved, grab your affiliate link via "Copy URL" and get started right away.',
    delay: 300,
    final: true,
  },
];
---

<section
  id="steps-section"
  class="relative overflow-hidden bg-navy-950 px-[clamp(20px,5vw,64px)] pt-[clamp(24px,4vh,40px)] pb-[clamp(56px,10vh,104px)]"
>
  <canvas id="steps-bg-canvas" class="pointer-events-none absolute inset-0 z-0" aria-hidden="true"></canvas>

  <div class="relative z-10 max-w-[1120px] mx-auto">
    <div
      aria-hidden="true"
      class="h-px mb-[clamp(24px,4vh,40px)]"
      style="background:linear-gradient(to right, transparent, var(--steps-divider) 48px calc(100% - 48px), transparent)"
    >
    </div>

    <p
      data-reveal
      class="flex items-center gap-3 mb-4.5 text-[12.5px] tracking-[0.18em] uppercase text-gold"
    >
      <span class="w-9 h-px bg-gold block"></span>
      In Four Steps
    </p>
    <h2
      data-reveal
      data-reveal-delay="80"
      class="font-medium text-[clamp(28px,4.4vw,44px)] leading-[1.14] tracking-[-0.015em] m-0 max-w-[20ch]"
      style="color: var(--steps-fg)"
    >
      How it works
    </h2>

    <div id="steps-track-wrap" class="relative mt-[clamp(40px,6vh,60px)]">
      <div
        aria-hidden="true"
        class="absolute left-[23px] top-6 bottom-6 w-px bg-gold/25"
      >
      </div>
      <div
        id="steps-progress"
        aria-hidden="true"
        class="absolute left-[23px] top-6 bottom-6 w-px origin-top scale-y-0"
        style="background:linear-gradient(to bottom, var(--steps-line-start), var(--color-gold), var(--color-emerald-hi));
          box-shadow:0 0 14px 2px rgba(217,189,133,.85), 0 0 34px 5px rgba(217,189,133,.5), 0 0 60px 8px rgba(47,163,115,.25);"
      >
      </div>

      <div class="flex flex-col gap-[clamp(28px,4vh,40px)]">
        {
          steps.map((s) => (
            <div
              data-reveal
              data-reveal-delay={s.delay}
              class="relative grid grid-cols-[48px_minmax(0,1fr)] gap-5.5 items-start"
            >
              <span
                class:list={[
                  "inline-flex items-center justify-center size-12 rounded-full bg-navy-950 font-medium text-[17px] tabular-nums border",
                  s.final
                    ? "border-emerald text-emerald-hi shadow-[0_0_20px_rgba(47,163,115,0.35)]"
                    : "border-gold text-gold shadow-[0_0_20px_rgba(217,189,133,0.3)]",
                ]}
              >
                {s.n}
              </span>
              <div class="pt-2.5">
                <h3
                  class="font-medium text-[clamp(19px,2.4vw,23px)] leading-[1.3] m-0"
                  style="color: var(--steps-fg)"
                >
                  {s.title}
                </h3>
                <p class="text-[15.5px] leading-[1.62] mt-2.5 max-w-[56ch]" style="color: var(--steps-fg-muted)">
                  {s.text}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-[clamp(56px,10vh,104px)]">
      <p
        data-reveal
        class="flex items-center gap-3 mb-4.5 text-[12.5px] tracking-[0.18em] uppercase text-gold"
      >
        <span class="w-9 h-px bg-gold block"></span>
        And then?
      </p>
      <h3
        data-reveal
        class="font-medium text-[clamp(22px,3.2vw,32px)] leading-[1.2] tracking-[-0.01em] m-0 max-w-[26ch]"
        style="color: var(--steps-fg)"
      >
        How you'll see your commission in the partner dashboard
      </h3>
      <p class="text-[15.5px] leading-[1.62] mt-3 max-w-[60ch]" style="color: var(--steps-fg-muted)">
        After every successful sale, the commission shows up directly in the
        CopeCart dashboard — trackable live, viewable anytime.
      </p>

      <div class="mt-8">
        <DashboardPreview />
      </div>
    </div>
  </div>
</section>

<style>
  #steps-section {
    --steps-fg: var(--color-ink);
    --steps-fg-muted: rgba(245, 241, 232, 0.74);
    --steps-divider: rgba(245, 241, 232, 0.12);
    --steps-line-start: #ffffff;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const section = document.querySelector<HTMLElement>("#steps-section");
  const canvas = document.querySelector<HTMLCanvasElement>("#steps-bg-canvas");

  if (section && canvas && !reduceMotion) {
    const ctx = canvas.getContext("2d");

    if (ctx) {
      // Background dissolves between these two flat tones; text/divider
      // colors interpolate between the same pair so everything stays
      // readable at every point along the scroll-driven transition.
      const DARK = { r: 5, g: 6, b: 10 }; // matches --color-navy-950
      const LIGHT = { r: 255, g: 255, b: 255 };

      const mixChannel = (a: number, b: number, t: number) => Math.round(a + (b - a) * t);
      // Foreground colors move the opposite way from the background: light
      // text at t=0 (background still dark) fading to dark text at t=1
      // (background gone white).
      const mixLightToDark = (t: number) =>
        `rgb(${mixChannel(LIGHT.r, DARK.r, t)}, ${mixChannel(LIGHT.g, DARK.g, t)}, ${mixChannel(LIGHT.b, DARK.b, t)})`;
      const smoothstep = (edge0: number, edge1: number, x: number) => {
        const t = Math.min(Math.max((x - edge0) / (edge1 - edge0), 0), 1);
        return t * t * (3 - 2 * t);
      };

      const CELL_SIZE = 48;
      // How long, in fillProgress units, each individual cell's own
      // pop-in takes. Thresholds are pre-compressed into [0, 1-BAND] (see
      // buildGrid) so that fillProgress=1 always finishes every cell's
      // animation exactly — otherwise cells whose threshold landed above
      // (1 - BAND) would never fully reach opaque, leaving faint squares
      // behind even once the section reads as "done".
      const BAND = 0.22;

      let cells: { x: number; y: number; threshold: number }[] = [];
      let cssWidth = 0;
      let cssHeight = 0;
      let fillProgress = 0;

      const buildGrid = () => {
        const rect = section.getBoundingClientRect();
        cssWidth = Math.max(1, rect.width);
        cssHeight = Math.max(1, rect.height);
        const dpr = Math.min(window.devicePixelRatio || 1, 2);

        canvas.width = Math.round(cssWidth * dpr);
        canvas.height = Math.round(cssHeight * dpr);
        canvas.style.width = `${cssWidth}px`;
        canvas.style.height = `${cssHeight}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const cols = Math.max(1, Math.ceil(cssWidth / CELL_SIZE));
        const rows = Math.max(1, Math.ceil(cssHeight / CELL_SIZE));
        cells = [];
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const cx = c * CELL_SIZE + CELL_SIZE / 2;
            const cy = r * CELL_SIZE + CELL_SIZE / 2;
            // Radial distance from the grid's center, 0 (center) to ~1
            // (corners) — cells pop in from the inside out. A little
            // random jitter keeps the ring from reading as a perfect,
            // mechanical circle.
            const dx = (cx - cssWidth / 2) / (cssWidth / 2);
            const dy = (cy - cssHeight / 2) / (cssHeight / 2);
            const dist = Math.min(Math.hypot(dx, dy) / Math.SQRT2, 1);
            const jitter = (Math.random() - 0.5) * 0.18;
            const threshold = Math.min(Math.max(dist + jitter, 0), 1) * (1 - BAND);
            cells.push({ x: c * CELL_SIZE, y: r * CELL_SIZE, threshold });
          }
        }
      };

      const draw = () => {
        ctx.clearRect(0, 0, cssWidth, cssHeight);
        ctx.fillStyle = `rgb(${DARK.r}, ${DARK.g}, ${DARK.b})`;
        ctx.fillRect(0, 0, cssWidth, cssHeight);

        ctx.fillStyle = `rgb(${LIGHT.r}, ${LIGHT.g}, ${LIGHT.b})`;
        for (const cell of cells) {
          const raw = Math.min(Math.max((fillProgress - cell.threshold) / BAND, 0), 1);
          if (raw <= 0) continue;
          // Ease + grow each cell from a small square up to full size
          // rather than a flat opacity wipe, so it reads as a soft "pop"
          // rather than a pixel just switching on.
          const eased = raw * raw * (3 - 2 * raw);
          const size = CELL_SIZE * (0.3 + 0.7 * eased);
          const inset = (CELL_SIZE - size) / 2;
          ctx.globalAlpha = eased;
          ctx.fillRect(cell.x + inset, cell.y + inset, size, size);
        }
        ctx.globalAlpha = 1;
      };

      const updateColors = () => {
        // Text/divider/line colors snap between light and dark over a
        // narrower band (0.35–0.65) than the background's own linear
        // sweep (0–1). Tracking the background 1:1 would leave text a
        // low-contrast grey for a third of the transition, right when the
        // backdrop itself is a noisy black/white scatter — the steeper
        // curve keeps foreground elements clearly light-on-dark or
        // dark-on-light through most of the scroll range and passes
        // through the ambiguous crossover quickly.
        const textT = smoothstep(0.35, 0.65, fillProgress);

        section.style.setProperty("--steps-fg", mixLightToDark(textT));
        section.style.setProperty(
          "--steps-fg-muted",
          `rgba(${mixChannel(LIGHT.r, DARK.r, textT)}, ${mixChannel(LIGHT.g, DARK.g, textT)}, ${mixChannel(LIGHT.b, DARK.b, textT)}, ${(0.74 - 0.04 * textT).toFixed(2)})`,
        );
        section.style.setProperty(
          "--steps-divider",
          `rgba(${mixChannel(LIGHT.r, DARK.r, textT)}, ${mixChannel(LIGHT.g, DARK.g, textT)}, ${mixChannel(LIGHT.b, DARK.b, textT)}, ${(0.12 + 0.03 * textT).toFixed(2)})`,
        );
        // The progress line's gradient starts white-hot against a dark
        // background; on a light background that same white start would
        // vanish, so its origin color flips toward near-black too.
        section.style.setProperty("--steps-line-start", mixLightToDark(textT));
      };

      const render = () => {
        draw();
        updateColors();
      };

      buildGrid();
      render();

      const resizeObserver = new ResizeObserver(() => {
        buildGrid();
        render();
      });
      resizeObserver.observe(section);

      // Starts once the section's top has scrolled up to 70% down the
      // viewport — shortly after it first appears, rather than waiting
      // for it to reach the center — then fills in over the following
      // ~40% of its time on screen and stays fully white for the rest,
      // including past the section's own end: once it's turned white it
      // never reverts back to dark.
      ScrollTrigger.create({
        trigger: section,
        start: "top 70%",
        end: "bottom top",
        scrub: 0.3,
        onUpdate: (self) => {
          const p = self.progress;
          fillProgress = p < 0.4 ? p / 0.4 : 1;
          render();
        },
      });
    }
  }
</script>
