---
import { Image } from "astro:assets";
import Icon from "../Icon.astro";
import avatarOne from "../../assets/images/manjeet-cta-portrait.avif";
---

<section
  id="benefit-zeit"
  class="relative px-[clamp(20px,5vw,64px)] min-h-[100svh] flex flex-col justify-center py-7 md:py-0 md:h-screen md:block"
>
  <div class="relative z-10 max-w-[1100px] mx-auto flex flex-col items-center justify-center md:h-full text-center">
    <div data-reveal>
      <p class="flex items-center justify-center gap-3 mb-4 text-[13px] tracking-[0.2em] uppercase text-gold">
        <span class="w-9 h-px bg-gold block"></span>
        1:1 Time
        <span class="w-9 h-px bg-gold block"></span>
      </p>
      <p
        class="font-medium text-[clamp(56px,9vw,112px)] leading-none tracking-[-0.03em] text-gold tabular-nums"
        style="text-shadow:0 0 40px rgba(217,189,133,.4), 0 0 6px rgba(255,255,255,.25)"
      >
        2 × 30
      </p>
      <p class="text-[clamp(17px,2vw,20px)] leading-[1.6] text-ink/80 max-w-[46ch] mt-5 mx-auto">
        Minutes: two personal 1:1 Zoom calls with Manjeet — for your
        questions, your situation.
      </p>
    </div>

    <div id="zeit-avatars" class="relative w-full h-[180px] sm:h-[220px] md:h-[280px] mt-8 md:mt-11">
      <div class="absolute inset-0 flex items-center justify-center">
        <svg id="zeit-connect-line" class="absolute" width="100%" height="2" style="max-width:280px">
          <line x1="0" y1="1" x2="100%" y2="1" stroke="#d9bd85" stroke-width="2" />
        </svg>
      </div>
      <div class="absolute inset-0 flex items-center justify-between sm:justify-center sm:gap-[clamp(60px,18vw,220px)]">
        <span
          id="zeit-avatar-left"
          class="avatar-photo relative shrink-0 flex items-center justify-center rounded-full overflow-hidden border-2 border-gold shadow-[0_0_40px_rgba(217,189,133,0.3)] bg-linear-to-br from-navy-800 to-navy-950"
        >
          <Icon name="user" class="w-[46%] h-[46%] text-gold/80" />
        </span>
        <span
          id="zeit-avatar-right"
          class="avatar-photo relative shrink-0 rounded-full overflow-hidden border-2 border-gold shadow-[0_0_40px_rgba(217,189,133,0.3)]"
        >
          <Image
            src={avatarOne}
            alt="Manjeet Singh Sangha in a personal conversation"
            width={240}
            height={240}
            class="size-full object-cover"
          />
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .avatar-photo {
    width: clamp(72px, 16vw, 160px);
    height: clamp(72px, 16vw, 160px);
  }
  #zeit-connect-line line {
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const section = document.querySelector<HTMLElement>("#benefit-zeit");
  const left = document.querySelector<HTMLElement>("#zeit-avatar-left");
  const right = document.querySelector<HTMLElement>("#zeit-avatar-right");
  const line = document.querySelector<SVGLineElement>("#zeit-connect-line line");

  if (section && left && right) {
    if (reduceMotion) {
      gsap.set([left, right], { x: 0, scale: 1, opacity: 1 });
      if (line) line.style.strokeDashoffset = "0";
    } else {
      const isDesktop = window.matchMedia("(min-width: 768px)").matches;
      const travel = isDesktop ? 40 : 24;

      gsap.set(left, { x: -travel, scale: 0.72, opacity: 0.65 });
      gsap.set(right, { x: travel, scale: 0.72, opacity: 0.65 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "+=45%",
          scrub: 0.6,
          pin: true,
          anticipatePin: 1,
        },
      });

      tl.to([left, right], { x: 0, scale: 1, opacity: 1, ease: "none" }, 0);
      if (line) tl.to(line, { strokeDashoffset: 0, ease: "none" }, 0.15);
    }
  }
</script>
