---
const envelopes = [
  { id: 0, width: "w-[32vw] max-w-[140px] sm:max-w-[160px]", wrap: "-mr-[8%]" },
  { id: 1, width: "w-[34vw] max-w-[150px] sm:max-w-[172px]", wrap: "mb-4 sm:mb-6" },
  { id: 2, width: "w-[32vw] max-w-[140px] sm:max-w-[160px]", wrap: "-ml-[8%]" },
];
---

<section
  id="benefit-zugang"
  class="relative px-[clamp(20px,5vw,64px)] min-h-[100svh] flex flex-col justify-center py-7 md:py-0 md:h-screen md:block"
>
  <div class="relative z-10 max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-12 items-center md:h-full">
    <div data-reveal>
      <p class="flex items-center gap-3 mb-4 text-[13px] tracking-[0.2em] uppercase text-gold">
        <span class="w-9 h-px bg-gold block"></span>
        Access
      </p>
      <h3
        id="zugang-count"
        class="font-medium text-[clamp(56px,9vw,112px)] leading-none tracking-[-0.03em] text-gold tabular-nums"
        style="text-shadow:0 0 40px rgba(217,189,133,.4), 0 0 6px rgba(255,255,255,.25)"
      >
        0×
      </h3>
      <p class="text-[13px] tracking-[0.14em] uppercase text-ink/50 mt-2">
        Per week
      </p>
      <p class="text-[clamp(17px,2vw,20px)] leading-[1.6] text-ink/80 max-w-[42ch] mt-5">
        Access to the winning-product newsletter — otherwise reserved for
        Gold customers. Three times a week, products hand-picked by Manjeet,
        delivered straight to your inbox.
      </p>
    </div>

    <div id="zugang-envelopes" class="relative h-[190px] sm:h-[240px] md:h-[300px] flex items-center justify-center">
      <div class="flex items-end">
        {
          envelopes.map((env) => (
            <div class={`zugang-env relative ${env.width} ${env.wrap}`} style={`z-index:${env.id === 1 ? 3 : env.id + 1}`}>
              <svg viewBox="0 0 160 120" class="w-full h-auto" aria-hidden="true">
                <defs>
                  <linearGradient id={`envBodyFill-${env.id}`} x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#10131f" stop-opacity="0.75" />
                    <stop offset="100%" stop-color="#05060a" stop-opacity="0.55" />
                  </linearGradient>
                </defs>
                <rect x="4" y="14" width="152" height="100" rx="12" fill={`url(#envBodyFill-${env.id})`} stroke="#d9bd85" stroke-width="2.5" />
                <path d="M8 20 L80 74 L152 20" fill="none" stroke="#d9bd85" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="128" cy="96" r="18" fill="#d9bd85" />
                <path d="M121 93 h14 l-1.6 11.5 a2 2 0 0 1 -2 1.7 h-6.8 a2 2 0 0 1 -2 -1.7 Z" fill="none" stroke="#0b0d16" stroke-width="1.7" stroke-linejoin="round" />
                <path d="M124.2 93 v-2.4 a3.8 3.8 0 0 1 7.6 0 v2.4" fill="none" stroke="#0b0d16" stroke-width="1.7" stroke-linecap="round" />
              </svg>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const section = document.querySelector<HTMLElement>("#benefit-zugang");
  const envs = document.querySelectorAll<HTMLElement>(".zugang-env");
  const counterEl = document.querySelector<HTMLElement>("#zugang-count");

  const REST_ROTATION = [-9, 2, 9];
  const ENTRY_ROTATION = [-27, 24, 29];
  const ENTRY_X = [-1, 0, 1];

  if (section && envs.length && counterEl) {
    if (reduceMotion) {
      envs.forEach((env, i) => {
        gsap.set(env, { x: 0, y: 0, rotation: REST_ROTATION[i], scale: 1, opacity: 1 });
      });
      counterEl.textContent = "3×";
    } else {
      const isDesktop = window.matchMedia("(min-width: 768px)").matches;
      const travelX = isDesktop ? 56 : 32;
      const travelY = isDesktop ? 70 : 44;
      const STAGGER = 0.3;
      const DUR = 0.6;
      const TOTAL = (envs.length - 1) * STAGGER + DUR;

      envs.forEach((env, i) => {
        gsap.set(env, {
          x: ENTRY_X[i] * travelX,
          y: travelY,
          rotation: ENTRY_ROTATION[i],
          scale: 0.7,
          opacity: 0,
        });
      });

      const counter = { val: 0 };

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: isDesktop ? "+=100%" : "+=45%",
          scrub: 0.6,
          pin: true,
          anticipatePin: 1,
        },
      });

      tl.to(
        counter,
        {
          val: 3,
          ease: "none",
          duration: TOTAL,
          onUpdate: () => {
            counterEl.textContent = `${Math.round(counter.val)}×`;
          },
        },
        0,
      );

      envs.forEach((env, i) => {
        tl.to(
          env,
          { x: 0, y: 0, rotation: REST_ROTATION[i], scale: 1, opacity: 1, ease: "none", duration: DUR },
          i * STAGGER,
        );
      });
    }
  }
</script>
