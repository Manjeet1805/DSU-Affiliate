---
// Stylized, simplified recreation of the CopeCart affiliate dashboard —
// not a 1:1 brand copy, just enough of the real layout (sidebar, tab bar,
// hero stat card, stat grid, yearly chart) to be immediately recognizable
// as "where the commission shows up". Built as one inline SVG on a fixed
// 2000x604 viewBox so every element scales proportionally with the
// section's width without any breakpoint-specific relayout.

const VB_W = 2000;
const VB_H = 604;

const smallCards = [
  { id: "monthly", label: "Monthly net income", value: "$0.00", target: "$300.00", goal: "Goal $0.00", percent: 6, icon: "calendar" },
  { id: "yearly", label: "Yearly net income", value: "$0.00", target: "$300.00", goal: "Goal $0.00", percent: 1, icon: "calendar" },
  { id: "clicks", label: "Link clicks", value: "0", target: "3", goal: "Goal 0", percent: 35, icon: "cursor" },
  { id: "days", label: "Days elapsed since goal start", value: "0 Day(s)", target: "1 Day(s)", goal: "Goal: 0 left", percent: 8, icon: "calendar" },
];

const CARD_GAP = 20;
const CARDS_X = 770;
const CARDS_RIGHT = 1995;
const CARDS_TOP = 55;
const CARDS_BOTTOM = 290;
const COL_W = (CARDS_RIGHT - CARDS_X - CARD_GAP) / 2;
const ROW_H = (CARDS_BOTTOM - CARDS_TOP - CARD_GAP) / 2;

const cardRects = smallCards.map((c, i) => {
  const col = i % 2;
  const row = Math.floor(i / 2);
  return {
    ...c,
    x: CARDS_X + col * (COL_W + CARD_GAP),
    y: CARDS_TOP + row * (ROW_H + CARD_GAP),
    w: COL_W,
    h: ROW_H,
  };
});

const sidebarItems = [
  { label: "Dashboard", icon: "grid", active: true },
  { label: "Products", icon: "box", active: false },
  { label: "Marketplace", icon: "store", active: false },
  { label: "Transactions", icon: "list", active: false },
];

const tabs = ["Executive", "Performance", "Leaderboard", "Income/Payouts"];

const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const CHART_X0 = 225;
const CHART_X1 = 1975;
const CHART_Y0 = 365;
const CHART_Y1 = 565;
const monthX = months.map((_, i) => CHART_X0 + (i * (CHART_X1 - CHART_X0)) / (months.length - 1));
const yTicks = [1, 0.8, 0.6, 0.4, 0.2, 0, -0.2, -0.4, -0.6, -0.8, -1];
const yFor = (v: number) => CHART_Y0 + (1 - (v + 1) / 2) * (CHART_Y1 - CHART_Y0);
const BASELINE_Y = yFor(0);
const RISEN_Y = yFor(0.92);
const PIVOT_INDEX = 7; // from "Aug" onward the line reflects the sale
const baselinePoints = monthX.map((x) => ({ x, y: BASELINE_Y }));
const risenPoints = monthX.map((x, i) => ({ x, y: i >= PIVOT_INDEX ? RISEN_Y : BASELINE_Y }));
const pointsToPath = (pts: { x: number; y: number }[]) => pts.map((p, i) => `${i === 0 ? "M" : "L"}${p.x},${p.y}`).join(" ");

// Compact mobile layout: same data, stacked instead of side-by-side, on a
// much smaller viewBox so text stays legible at phone widths without any
// horizontal scrolling.
const VBM_W = 340;
const VBM_H = 110;
const CHART_X0_M = 6;
const CHART_X1_M = 334;
const CHART_Y0_M = 10;
const CHART_Y1_M = 100;
const monthXM = months.map((_, i) => CHART_X0_M + (i * (CHART_X1_M - CHART_X0_M)) / (months.length - 1));
const yForM = (v: number) => CHART_Y0_M + (1 - (v + 1) / 2) * (CHART_Y1_M - CHART_Y0_M);
const BASELINE_Y_M = yForM(0);
const baselinePointsM = monthXM.map((x) => ({ x, y: BASELINE_Y_M }));
---

<div class="relative -mx-[clamp(20px,5vw,64px)] px-[clamp(20px,5vw,64px)]">
  <div
    id="dashboard-preview"
    data-reveal
    class="relative rounded-[20px] overflow-hidden border border-black/5 shadow-[0_30px_80px_-24px_rgba(10,12,30,0.45)]"
  >
  <div class="hidden md:block">
    <svg viewBox={`0 0 ${VB_W} ${VB_H}`} class="block w-full h-auto" role="img" aria-label="Simplified view of the CopeCart partner dashboard showing the commission after a successful sale">
      <defs>
        <linearGradient id="dp-hero-gradient" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#16225c" />
          <stop offset="100%" stop-color="#3d5fe0" />
        </linearGradient>
        <filter id="dp-card-shadow" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="6" stdDeviation="9" flood-color="#1b2559" flood-opacity="0.09" />
        </filter>
      </defs>

      <rect x="0" y="0" width={VB_W} height={VB_H} fill="#eef1f7" />

      <rect x="0" y="0" width="140" height={VB_H} fill="#ffffff" />
      <line x1="140" y1="0" x2="140" y2={VB_H} stroke="#e6e9f2" stroke-width="1" />

      <text x="20" y="26" font-size="10.5" font-weight="700" letter-spacing="1.5" fill="#9aa3b8" font-family="inherit">OPERATIONS</text>

      {
        sidebarItems.map((item, i) => {
          const y = 46 + i * 38;
          const iconX = 30;
          const iconY = y + 17;
          const textColor = item.active ? "#1b2559" : "#8992a8";
          return (
            <g>
              {item.active && <rect x="10" y={y} width="120" height="34" rx="8" fill="#eef2fd" />}
              <g transform={`translate(${iconX} ${iconY})`} stroke={textColor} fill="none" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                {item.icon === "grid" && (
                  <>
                    <rect x="-6" y="-6" width="5" height="5" rx="1" fill={textColor} stroke="none" />
                    <rect x="1" y="-6" width="5" height="5" rx="1" fill={textColor} stroke="none" />
                    <rect x="-6" y="1" width="5" height="5" rx="1" fill={textColor} stroke="none" />
                    <rect x="1" y="1" width="5" height="5" rx="1" fill={textColor} stroke="none" />
                  </>
                )}
                {item.icon === "box" && (
                  <>
                    <rect x="-6" y="-6" width="12" height="12" rx="2" />
                    <line x1="-6" y1="-1.5" x2="6" y2="-1.5" />
                  </>
                )}
                {item.icon === "store" && (
                  <>
                    <path d="M-6,-1.5 L0,-7 L6,-1.5" />
                    <rect x="-5" y="-1.5" width="10" height="7.5" />
                  </>
                )}
                {item.icon === "list" && (
                  <>
                    <line x1="-6" y1="-4" x2="6" y2="-4" />
                    <line x1="-6" y1="0" x2="3" y2="0" />
                    <line x1="-6" y1="4" x2="6" y2="4" />
                  </>
                )}
              </g>
              <text x="44" y={y + 22} font-size="13.5" font-weight={item.active ? "600" : "500"} fill={textColor} font-family="inherit">
                {item.label}
              </text>
            </g>
          );
        })
      }

      {
        tabs.map((tab, i) => {
          const x = 175 + i * 95;
          const active = i === 0;
          return (
            <g>
              <text x={x} y="26" font-size="14.5" font-weight={active ? "700" : "500"} fill={active ? "#1b2559" : "#9aa3b8"} font-family="inherit">
                {tab}
              </text>
              {active && <line x1={x} y1="34" x2={x + 58} y2="34" stroke="#1b2559" stroke-width="2" />}
            </g>
          );
        })
      }

      <rect x="155" y="55" width="600" height="235" rx="18" fill="url(#dp-hero-gradient)" filter="url(#dp-card-shadow)" />
      <circle cx="193" cy="95" r="18" fill="rgba(255,255,255,.16)" />
      <g transform="translate(193 95)" stroke="#fff" fill="none" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <rect x="-6" y="-5" width="12" height="10" rx="1.5" />
        <line x1="-6" y1="-2" x2="6" y2="-2" />
        <line x1="-3" y1="-7" x2="-3" y2="-5" />
        <line x1="3" y1="-7" x2="3" y2="-5" />
      </g>
      <circle cx="717" cy="95" r="12" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="1.3" />
      <text x="717" y="99.5" font-size="11" fill="rgba(255,255,255,.75)" text-anchor="middle" font-family="inherit">i</text>

      <text id="dp-hero-value" x="193" y="178" font-size="52" font-weight="700" fill="#ffffff" font-family="inherit">$0.00</text>
      <text x="193" y="203" font-size="15" fill="rgba(255,255,255,.72)" font-family="inherit">Daily net income</text>

      <text x="193" y="271" font-size="13" fill="rgba(255,255,255,.82)" font-family="inherit">Goal $0.00</text>
      <text id="dp-hero-percent" x="717" y="271" font-size="13" fill="rgba(255,255,255,.82)" text-anchor="end" font-family="inherit">0%</text>
      <rect x="193" y="278" width="524" height="5" rx="2.5" fill="rgba(255,255,255,.22)" />
      <rect
        id="dp-hero-bar"
        x="193"
        y="278"
        width="524"
        height="5"
        rx="2.5"
        fill="#ffffff"
        style="transform: scaleX(0); transform-origin: 193px 280.5px;"
      />

      {
        cardRects.map((c) => (
          <g>
            <rect x={c.x} y={c.y} width={c.w} height={c.h} rx="14" fill="#ffffff" stroke="#e9ecf3" filter="url(#dp-card-shadow)" />
            <circle cx={c.x + 34} cy={c.y + 32} r="15" fill="#eaf1ff" />
            <g transform={`translate(${c.x + 34} ${c.y + 32})`} stroke="#3d5fe0" fill="none" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              {c.icon === "calendar" && (
                <>
                  <rect x="-5.5" y="-4.5" width="11" height="9" rx="1.3" />
                  <line x1="-5.5" y1="-1.8" x2="5.5" y2="-1.8" />
                  <line x1="-2.7" y1="-6.5" x2="-2.7" y2="-4.5" />
                  <line x1="2.7" y1="-6.5" x2="2.7" y2="-4.5" />
                </>
              )}
              {c.icon === "cursor" && <path d="M-4,-6 L4,0.5 L0.3,1.2 L2.2,6 L-0.6,6 L-2.6,1 L-5.5,3 Z" fill="#3d5fe0" stroke="none" />}
            </g>
            <text id={`dp-${c.id}-value`} x={c.x + 18} y={c.y + 63} font-size="24" font-weight="700" fill="#1b2559" font-family="inherit">
              {c.value}
            </text>
            <text x={c.x + 18} y={c.y + 82} font-size="12.5" fill="#8992a8" font-family="inherit">
              {c.label}
            </text>

            <text x={c.x + 18} y={c.y + 100} font-size="11.5" fill="#8992a8" font-family="inherit">
              {c.goal}
            </text>
            <text id={`dp-${c.id}-percent`} x={c.x + c.w - 18} y={c.y + 100} font-size="11.5" fill="#8992a8" text-anchor="end" font-family="inherit">
              0%
            </text>
            <rect x={c.x + 18} y={c.y + 106} width={c.w - 36} height="4" rx="2" fill="#eef0f6" />
            <rect
              id={`dp-${c.id}-bar`}
              x={c.x + 18}
              y={c.y + 106}
              width={c.w - 36}
              height="4"
              rx="2"
              fill="#3d5fe0"
              style={`transform: scaleX(0); transform-origin: ${c.x + 18}px ${c.y + 108}px;`}
            />
          </g>
        ))
      }

      <rect x="155" y="310" width="1840" height="290" rx="18" fill="#ffffff" stroke="#e9ecf3" filter="url(#dp-card-shadow)" />
      <text x="175" y="335" font-size="16" font-weight="600" fill="#1b2559" font-family="inherit">Yearly net income performance</text>

      <line x1="1655" y1="331" x2="1673" y2="331" stroke="#3d5fe0" stroke-width="2" stroke-dasharray="1 4" stroke-linecap="round" />
      <text x="1679" y="335" font-size="12" fill="#8992a8" font-family="inherit">Goal</text>
      <line x1="1740" y1="331" x2="1758" y2="331" stroke="#1b2559" stroke-width="2" />
      <text x="1764" y="335" font-size="12" fill="#8992a8" font-family="inherit">Jan 2026 - Dec 2026</text>

      {
        yTicks.map((v) => {
          const y = yFor(v);
          return (
            <g>
              <line x1={CHART_X0} y1={y} x2={CHART_X1} y2={y} stroke="#eef0f6" stroke-width="1" />
              <text x={CHART_X0 - 12} y={y + 4} font-size="11" fill="#9aa3b8" text-anchor="end" font-family="inherit">
                ${v.toFixed(2)}
              </text>
            </g>
          );
        })
      }

      {
        monthX.map((x, i) => (
          <text x={x} y={CHART_Y1 + 24} font-size="11" fill="#9aa3b8" text-anchor="middle" font-family="inherit">
            {months[i]}, 2026
          </text>
        ))
      }

      <path id="dp-chart-line" d={pointsToPath(baselinePoints)} fill="none" stroke="#1b2559" stroke-width="2.5" stroke-linejoin="round" />
      {
        baselinePoints.map((p, i) => (
          <circle id={`dp-chart-dot-${i}`} cx={p.x} cy={p.y} r="4.5" fill="#1b2559" />
        ))
      }

      <g id="dp-vote-tab" transform={`translate(${VB_W - 22} ${(CHART_Y0 + CHART_Y1) / 2})`}>
        <rect x="-18" y="-72" width="36" height="144" rx="6" fill="#3d5fe0" />
        <text x="0" y="0" font-size="12" font-weight="600" fill="#ffffff" text-anchor="middle" letter-spacing="1.2" transform="rotate(90)" font-family="inherit">
          SUGGEST &amp; VOTE
        </text>
      </g>
    </svg>
  </div>

  <div class="md:hidden p-4" style="background:#eef1f7">
    <div class="rounded-[14px] p-4" style="background:linear-gradient(135deg, #16225c 0%, #3d5fe0 100%)">
      <div class="flex items-center gap-1.5 text-white/70 text-[11px] font-medium">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="17" rx="2" />
          <line x1="3" y1="9" x2="21" y2="9" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="16" y1="2" x2="16" y2="6" />
        </svg>
        Daily net income
      </div>
      <div id="dp-hero-value-m" class="text-white font-bold text-[30px] leading-tight mt-1">$0.00</div>
      <div class="flex items-center justify-between text-[11px] text-white/75 mt-3">
        <span>Goal $0.00</span>
        <span id="dp-hero-percent-m">0%</span>
      </div>
      <div class="h-1 rounded-full bg-white/20 mt-1.5 overflow-hidden">
        <div id="dp-hero-bar-m" class="h-full bg-white rounded-full" style="width:0%"></div>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-2.5 mt-2.5">
      {
        smallCards.map((c) => (
          <div class="rounded-[12px] bg-white border border-[#e9ecf3] px-3 py-2.5">
            <div id={`dp-${c.id}-value-m`} class="text-[#1b2559] font-bold text-[17px] leading-tight">
              {c.value}
            </div>
            <div class="text-[#8992a8] text-[10px] mt-0.5 leading-snug">{c.label}</div>
          </div>
        ))
      }
    </div>

    <div class="rounded-[12px] bg-white border border-[#e9ecf3] p-3 mt-2.5">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[#1b2559] text-[12px] font-semibold">Yearly net income</span>
        <span class="text-[#9aa3b8] text-[10px]">Jan – Dec 2026</span>
      </div>
      <svg viewBox={`0 0 ${VBM_W} ${VBM_H}`} class="block w-full h-auto" aria-hidden="true">
        <path id="dp-chart-line-m" d={pointsToPath(baselinePointsM)} fill="none" stroke="#1b2559" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
      </svg>
    </div>
  </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Mirrors the geometry computed in this component's frontmatter — kept
  // in sync manually since frontmatter runs at build time and this script
  // runs in the browser.
  const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const CHART_X0 = 225;
  const CHART_X1 = 1975;
  const CHART_Y0 = 365;
  const CHART_Y1 = 565;
  const monthX = months.map((_, i) => CHART_X0 + (i * (CHART_X1 - CHART_X0)) / (months.length - 1));
  const yFor = (v: number) => CHART_Y0 + (1 - (v + 1) / 2) * (CHART_Y1 - CHART_Y0);
  const BASELINE_Y = yFor(0);
  const RISEN_Y = yFor(0.92);
  const PIVOT_INDEX = 7;
  const cardRects = [
    { id: "monthly", percent: 6 },
    { id: "yearly", percent: 1 },
    { id: "clicks", percent: 35 },
    { id: "days", percent: 8 },
  ];

  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wrap = document.querySelector<HTMLElement>("#dashboard-preview");

  const heroValueEl = document.querySelector<SVGTextElement>("#dp-hero-value");
  const heroBarEl = document.querySelector<SVGElement>("#dp-hero-bar");
  const heroPercentEl = document.querySelector<SVGTextElement>("#dp-hero-percent");
  const lineEl = document.querySelector<SVGPathElement>("#dp-chart-line");
  const dots = months.map((_, i) => document.querySelector<SVGCircleElement>(`#dp-chart-dot-${i}`));

  // Mobile-layout equivalents (see the frontmatter's VBM_* constants for the
  // matching compact viewBox this geometry is derived from).
  const CHART_X0_M = 6;
  const CHART_X1_M = 334;
  const CHART_Y0_M = 10;
  const CHART_Y1_M = 100;
  const monthXM = months.map((_, i) => CHART_X0_M + (i * (CHART_X1_M - CHART_X0_M)) / (months.length - 1));
  const yForM = (v: number) => CHART_Y0_M + (1 - (v + 1) / 2) * (CHART_Y1_M - CHART_Y0_M);
  const BASELINE_Y_M = yForM(0);
  const RISEN_Y_M = yForM(0.92);
  const heroValueElM = document.querySelector<HTMLElement>("#dp-hero-value-m");
  const heroBarElM = document.querySelector<HTMLElement>("#dp-hero-bar-m");
  const heroPercentElM = document.querySelector<HTMLElement>("#dp-hero-percent-m");
  const lineElM = document.querySelector<SVGPathElement>("#dp-chart-line-m");

  const formatDollar = (n: number) => `$${n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

  const setBar = (el: SVGElement | null, t: number) => {
    if (el) el.style.transform = `scaleX(${t})`;
  };

  const pointsToPath = (ys: number[]) => monthX.map((x, i) => `${i === 0 ? "M" : "L"}${x},${ys[i]}`).join(" ");
  const pointsToPathM = (ys: number[]) => monthXM.map((x, i) => `${i === 0 ? "M" : "L"}${x},${ys[i]}`).join(" ");

  const applyProgress = (t: number) => {
    const daily = 300 * t;
    if (heroValueEl) heroValueEl.textContent = formatDollar(daily);
    if (heroPercentEl) heroPercentEl.textContent = `${Math.round(18 * t)}%`;
    setBar(heroBarEl, 0.18 * t);

    if (heroValueElM) heroValueElM.textContent = formatDollar(daily);
    if (heroPercentElM) heroPercentElM.textContent = `${Math.round(18 * t)}%`;
    if (heroBarElM) heroBarElM.style.width = `${18 * t}%`;

    cardRects.forEach((c) => {
      const valueEl = document.querySelector<SVGTextElement>(`#dp-${c.id}-value`);
      const percentEl = document.querySelector<SVGTextElement>(`#dp-${c.id}-percent`);
      const barEl = document.querySelector<SVGElement>(`#dp-${c.id}-bar`);
      const valueElM = document.querySelector<HTMLElement>(`#dp-${c.id}-value-m`);
      let text = "";
      if (c.id === "monthly" || c.id === "yearly") {
        text = formatDollar(300 * t);
      } else if (c.id === "clicks") {
        text = `${Math.round(3 * t)}`;
      } else if (c.id === "days") {
        text = `${Math.round(1 * t)} Day(s)`;
      }
      if (valueEl) valueEl.textContent = text;
      if (valueElM) valueElM.textContent = text;
      if (percentEl) percentEl.textContent = `${Math.round(c.percent * t)}%`;
      setBar(barEl, (c.percent / 100) * t);
    });

    const ys = months.map((_, i) => {
      const base = BASELINE_Y;
      const risen = i >= PIVOT_INDEX ? RISEN_Y : BASELINE_Y;
      return base + (risen - base) * t;
    });
    if (lineEl) lineEl.setAttribute("d", pointsToPath(ys));
    dots.forEach((dot, i) => dot && dot.setAttribute("cy", String(ys[i])));

    const ysM = months.map((_, i) => {
      const base = BASELINE_Y_M;
      const risen = i >= PIVOT_INDEX ? RISEN_Y_M : BASELINE_Y_M;
      return base + (risen - base) * t;
    });
    if (lineElM) lineElM.setAttribute("d", pointsToPathM(ysM));
  };

  if (wrap) {
    if (reduceMotion) {
      applyProgress(1);
    } else {
      applyProgress(0);
      ScrollTrigger.create({
        trigger: wrap,
        start: "top 75%",
        end: "top 30%",
        scrub: 0.4,
        onUpdate: (self) => applyProgress(self.progress),
      });
    }
  }
</script>
